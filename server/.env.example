# ---- Core ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Render = 1, Docker+nginx = 1)
TRUST_PROXY=1
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/two_oclock

# ---- Auth (generate with: openssl rand -hex 48) ----
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string-aaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=change-me-to-another-64-char-random-string-bbbbbbbbbbbbbbbbb
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=60

# ---- Store ----
STORE_NAME=Timeless Luxury Two O'Clock
STORE_SUPPORT_EMAIL=support@example.com
# Digits only, international format, e.g. 265999000000 (Malawi)
STORE_WHATSAPP_NUMBER=

# ---- Email (if SMTP_HOST is empty, emails are logged instead of sent) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Two O'Clock <no-reply@example.com>

# ---- Media ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe does not settle MWK; charge in this currency at STRIPE_MWK_RATE MWK per 1 unit.
STRIPE_CURRENCY=usd
STRIPE_MWK_RATE=1750
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_WEBHOOK_SECRET=
MPAMBA_BASE_URL=
MPAMBA_API_KEY=
MPAMBA_WEBHOOK_SECRET=

# ---- Seeding only ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
